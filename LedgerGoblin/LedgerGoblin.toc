# ----------------------------------------------------------------------------
# Core. Order matters: Init creates the namespace, then locales/constants/util
# are consumed by the database, which must be ready before any module loads.
# ----------------------------------------------------------------------------
Core\Init.lua
Core\Locales.lua
Core\Constants.lua
Core\Util.lua
Core\Widgets.lua
Core\Widgets.xml
Core\Events.lua
Core\DB.lua

# ----------------------------------------------------------------------------
# Modules. Roster + Logger are passive services the Engine leans on; Config is
# the user-facing panel and is loaded last so it can see everything.
# ----------------------------------------------------------------------------
Modules\Roster.lua
Modules\Logger.lua
Modules\Engine.lua
Modules\Config.lua
